# ============================================
# CONTENTSTACK ONBOARDING SYSTEM - ENV CONFIG
# ============================================

# OpenAI API Configuration (Required for AI Agents)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Contentstack API Credentials (Required for API Operations)
# Get these from your Contentstack account settings
# https://app.contentstack.com/#!/settings/tokens

# Authentication Token - Used to authenticate API requests
CONTENTSTACK_AUTH_TOKEN=your_contentstack_auth_token_here

# Organization ID - Your Contentstack organization identifier
CONTENTSTACK_ORG_ID=your_organization_id_here

# API Key - Stack-specific API key (created during stack setup, can be left empty initially)
CONTENTSTACK_API_KEY=your_api_key_here

# Management Token - For advanced operations (optional)
CONTENTSTACK_MANAGEMENT_TOKEN=your_management_token_here

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual credentials in .env
# 3. Never commit .env to git (it's in .gitignore)
# 4. Run: npm run dev
# 5. Open: http://localhost:4111
